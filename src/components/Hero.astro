---
import { Mail } from '@lucide/astro';
---

<div class="flex items-center justify-center min-h-screen" id="home">
    <div class="max-w-7xl flex items-center lg:gap-20 w-full flex-col-reverse lg:flex-row lg:justify-between">
        <!-- Left -->
        <div class="max-w-2xl text-center lg:text-left"> 
            
            <!-- Badge Status -->
            <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-4 py-2 text-sm text-emerald-400">
                <span class="size-2 rounded-full bg-emerald-400 animate-pulse"></span>
                Available for Work
            </div>

            <p class="mt-2 text-lg text-secondary">Hi, I'm</p>

            <p class="mt-2 font-extrabold text-4xl sm:text-5xl lg:text-6xl text-primary leading-tight">Marc Steven <span class="text-[#5290DA] block">Nagamany</span></p>

            <!-- Role -->
            <div class="mt-6 flex items-center justify-center gap-3 lg:justify-start">
                <div class="w-10 h-px bg-[#5290DA]/50"></div>
                <span class="font-semibold uppercase tracking-[5px]">Junior Web Developer</span>
                <div class="w-10 h-px bg-[#5290DA]/50"></div>
            </div>

            <p class="mt-6 text-secondary">
                Less <span class="text-[#5290DA] font-semibold uppercase">clutter</span>.
                More <span class="text-[#5290DA] font-semibold uppercase">purpose</span>.
                Built with <span class="text-[#5290DA] font-semibold uppercase">intention</span>.
            </p>

            <div class="mt-10 flex gap-3 justify-center lg:justify-start">
                <a href="#projects"
                    class="rounded-xl px-6 py-3 bg-[#5290DA] hover:bg-[#3B82F6] transition-all duration-300 hover:-translate-y-2"
                >
                    View Projects
                </a>

                <a
                    href="https://drive.google.com/file/d/1z5SxONHUgNWs51PamJ9N221z3ugB6ZNr/view?usp=sharing"
                    target="_blank"
                    class="rounded-xl border border-white/10 bg-[#131722] px-6 py-3 font-medium transition-all duration-300 hover:-translate-y-2 hover:border-[#5290DA]/40"
                >
                    Resume
                </a>
            </div>

            <!-- Icons -->
            <div class="flex items-center gap-2 mt-4 justify-center lg:justify-start">
                <a
                    href="https://github.com/tebsss17"
                    target="_blank"
                    class="group rounded-xl border border-white/10 bg-[#131722] p-3 transition-all duration-300 hover:-translate-y-1 hover:border-[#5290DA] hover:bg-[#1D4E89]/20">

                    <img
                        src="/images/github-dark.svg"
                        alt="GitHub"
                        class="size-6 transition-transform duration-300 group-hover:scale-110">

                </a>

                <a
                    href="https://www.linkedin.com/in/marc-steven-nagamany-03b2762b5/"
                    target="_blank"
                    class="group rounded-xl border border-white/10 bg-[#131722] p-3 transition-all duration-300 hover:-translate-y-1 hover:border-[#5290DA] hover:bg-[#1D4E89]/20">

                    <img
                        src="/images/linkedin.svg"
                        alt="LinkedIn"
                        class="size-6 transition-transform duration-300 group-hover:scale-110">

                </a>

                <a  
                    href="mailto:marcstevennagamany17@gmail.com?subject=Portfolio%20Inquiry"
                    class="group rounded-xl border border-white/10 bg-[#131722] p-3 transition-all duration-300 hover:-translate-y-1 hover:border-[#5290DA] hover:bg-[#1D4E89]/20">

                    <Mail class="size-6 transition-transform duration-300 group-hover:scale-110"/>

                </a>

            </div>
        </div>

        <!-- Right -->
        <div class="relative flex items-center justify-center w-[280px] h-[280px] sm:w-[360px] sm:h-[360px] lg:w-[520px] lg:h-[520px]">

            <!-- Blue Glow -->
            <div
                class="absolute w-52 h-52 sm:w-72 sm:h-72lg:w-[430px] lg:h-[430px] rounded-full bg-[#5290DA]/40 blur-[90px] animate-pulse">
            </div>

            <!-- Image -->
            <img
                src="/images/profile.jpg"
                alt="Marc Steven"

                class="
                    relative
                    z-10

                    h-56 w-56
                    sm:h-72 sm:w-72
                    lg:h-[430px] lg:w-[430px]

                    rounded-full
                    object-cover

                    border
                    border-[#5290DA]/40

                    shadow-[0_0_35px_rgba(82,144,218,.20)]

                    float
                "
            />

        </div>
        
    </div>
</div>